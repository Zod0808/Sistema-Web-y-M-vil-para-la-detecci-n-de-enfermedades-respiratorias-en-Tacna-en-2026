# RespiCare Tacna - Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://username:password@host:27017/respicare?authSource=admin
REDIS_URL=redis://localhost:6379

# MongoDB pool tuning (optional, defaults shown)
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=5

# ── Authentication ────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 64
JWT_SECRET=change_me_strong_jwt_secret
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_me_strong_refresh_secret
JWT_REFRESH_EXPIRE=30d

# ── AI / ML service ───────────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
OPENAI_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@respicare.tacna
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=RespiCare <noreply@respicare.tacna>

# ── Push notifications ────────────────────────────────────────────────────────
# Provider: none | firebase | onesignal
PUSH_PROVIDER=none
# PUSH_API_KEY=
# PUSH_PROJECT_ID=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://app.respicare.tacna,https://respicare.tacna

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# INTERNAL_SERVICE_TOKENS=token1,token2
# CRITICAL_ALERT_ROLES=doctor,admin

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ── Optional integrations ─────────────────────────────────────────────────────
# DRUG_INTERACTION_API_URL=
# DRUG_INTERACTION_API_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# SENTRY_ENABLED=true
# SENTRY_DSN=https://...@sentry.io/...