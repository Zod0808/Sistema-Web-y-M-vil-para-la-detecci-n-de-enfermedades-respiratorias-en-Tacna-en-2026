{
  "name": "respicare-backend",
  "version": "1.0.0",
  "description": "Backend API para RespiCare Tacna - Sistema de Gestión de Enfermedades Respiratorias",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:clean": "node dist/index-clean.js",
    "dev": "node src/index-dev.js",
    "dev:original": "nodemon src/index.ts",
    "dev:clean": "nodemon src/index-clean.ts",
    "build": "node scripts/build-with-errors.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:performance": "jest tests/performance",
    "test:stress": "jest tests/stress",
    "test:load": "k6 run tests/load/k6-load-tests.js",
    "test:security": "jest tests/security",
    "test:database": "jest tests/database",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dry-run",
    "test:mutation:incremental": "stryker run --incremental",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "analyze": "npm run lint && npm run type-check && npm audit",
    "code-quality": "npm run analyze && npm run test:coverage",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:demo": "ts-node --transpile-only src/scripts/seedDemoData.ts",
    "seed:alerts": "ts-node src/scripts/seedAlerts.ts",
    "generate": "bash scripts/generate-code.sh",
    "generate:dtos": "ts-node src/generators/dto-generator.ts",
    "generate:repositories": "ts-node src/generators/repository-generator.ts",
    "generate:all": "npm run generate:dtos && npm run generate:repositories",
    "validate:models": "tsc --project tsconfig.validation.json --noEmit",
    "validate:openapi": "openapi-generator-cli validate -i openapi/respicare-api.yaml",
    "docs:generate": "typedoc --out docs/api src",
    "diagrams:generate": "java -jar tools/plantuml.jar ../docs/diagrams/*.puml -o ../docs/diagrams/output",
    "kill-port": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 -Port 3001",
    "kill-port:3001": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 -Port 3001"
  },
  "keywords": [
    "medical",
    "respiratory",
    "api",
    "nodejs",
    "typescript",
    "mongodb"
  ],
  "author": "RespiCare Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@sentry/node": "^7.91.0",
    "@sentry/profiling-node": "^7.91.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "messagebird": "^3.8.1",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.14.0",
    "prom-client": "^15.1.0",
    "redis": "^4.6.10",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "twilio": "^5.10.6",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "xml2js": "^0.6.2",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.0.0",
    "@stryker-mutator/jest-runner": "^8.0.0",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.12.12",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-extended": "^6.0.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
