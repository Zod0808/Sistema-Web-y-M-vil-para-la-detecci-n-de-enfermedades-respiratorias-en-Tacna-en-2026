  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: SERVICIOS DE BACKEND (capa de servicio)
' ═══════════════════════════════════════════════════════════════════

package "Servicios de Backend" #F1F5F9 {

  class AlertService {
    + createAlert(data) : Alert
    + getAlerts(filters) : Alert[]
    + acknowledgeAlert(id, userId) : Alert
    + resolveAlert(id, userId) : Alert
    + sendNotification(alert, channels) : void
  }

  class AIIntegrationService {
    + analyzeSymptoms(symptoms) : AIAnalysis
    + getChatResponse(message, history) : String
    + predictDisease(vitals, symptoms) : PossibleDiagnosis[]
    + getUrgencyScore(symptoms) : Number
  }

  class EmergencyService {
    + createEmergency(patientId, location) : Emergency
    + dispatchAmbulance(emergencyId) : void
    + notifyDoctor(emergencyId, doctorId) : void
    + getStatus(emergencyId) : String
  }

  class LabService {
    + importResults(data) : LabResult[]
    + getResults(patientId) : LabResult[]
    + detectAbnormal(patientId) : LabResult[]
    + syncWithExternal() : void
  }

  class SMSService {
    + send(to, message) : void
    + sendBulk(recipients, message) : void
    + getDeliveryStatus(messageId) : String
  }

  class FHIRService {
    + exportPatient(patientId) : FHIRBundle
    + importResource(resource) : void
    + validateResource(resource) : Boolean
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: CAPACITOR / MOBILE
' ═══════════════════════════════════════════════════════════════════

package "Capa Mobile (Capacitor)" #E0F2FE {

  class NativeStorage {
    {static} setItem(key, value) : void
    {static} getItem(key) : String
    {static} removeItem(key) : void
    {static} clear() : void
    {static} setJSON(key, value) : void
    {static} getJSON(key) : Object
    {static} setBool(key, value) : void
    {static} getBool(key) : Boolean
  }

  class NotificationService {
    + init() : Boolean
    + sendAlert(options) : Number
    + scheduleReminder(options) : Number
    + scheduleMedicationReminder(med, hour, min) : Number
    + scheduleAppointmentReminder(doctor, date) : Number
    + cancelNotification(id) : void
    + cancelAll() : void
  }

  class BiometricAuthHook {
    + isAvailable : Boolean
    + biometryType : BiometryType
    + isEnabled : Boolean
    + loading : Boolean
    + error : String
    --
    + authenticate(options) : Boolean
    + toggleBiometric(enable) : Boolean
  }

  class GeolocationHook {
    + location : GeoLocation
    + error : String
    + loading : Boolean
    + permissionGranted : Boolean
    --
    + getCurrentLocation() : GeoLocation
    + startWatching() : void
    + stopWatching() : void
    + requestPermission() : Boolean
    + getEmergencyLocationUrl() : String
  }

  class NetworkStatusHook {
    + isOnline : Boolean
