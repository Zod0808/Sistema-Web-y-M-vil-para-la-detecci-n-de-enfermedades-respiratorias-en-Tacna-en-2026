' ═══════════════════════════════════════════════════════════════════
' PAQUETE: REPORTES Y ANALÍTICA
' ═══════════════════════════════════════════════════════════════════

package "Reportes y Analítica" #F8FAFC {

  class AutomaticReport {
    + _id : ObjectId
    + generatedBy : String
    + type : ReportType
    + period : ReportPeriod
    + status : ReportStatus
    + riskLevel : RiskLevel
    + dateRange : DateRange
    + metrics : Object
    + data : Object
    + format : ReportFormat
    + filePath : String
    + exportedAt : Date
    + createdAt : Date
    --
    + generate() : void
    + export(format) : String
    + getMetrics() : Object
    {static} findByType(type) : AutomaticReport[]
    {static} getStats() : Object
  }

