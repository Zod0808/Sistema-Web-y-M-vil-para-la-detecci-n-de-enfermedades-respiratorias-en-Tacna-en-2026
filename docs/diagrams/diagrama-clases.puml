  }

  class GeoLocation {
    + latitude : Number
    + longitude : Number
    + accuracy : Number
    + altitude : Number
    + speed : Number
    + timestamp : Number
  }

  enum ConnectionType {
    WIFI
    FOUR_G
    THREE_G
    TWO_G
    NONE
    UNKNOWN
  }

}

' ═══════════════════════════════════════════════════════════════════
' RELACIONES DE HERENCIA
' ═══════════════════════════════════════════════════════════════════

Usuario <|-- Paciente
Usuario <|-- Doctor
Usuario <|-- Administrador
Usuario "1" --> "0..*" AuditLog : genera >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES DE COMPOSICIÓN / AGREGACIÓN — Historial Clínico
' ═══════════════════════════════════════════════════════════════════

MedicalHistory "1" *-- "0..*" Symptom : contiene >
MedicalHistory "1" *-- "1" Vitals : registra >
LabResult "1" *-- "0..1" ReferenceRange : tiene >
Prescription "1" *-- "1..*" Medication : incluye >
Prescription "1" *-- "0..*" DrugInteraction : detecta >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES ENTRE ENTIDADES PRINCIPALES (asociaciones)
' ═══════════════════════════════════════════════════════════════════

Paciente "1" --> "0..*" MedicalHistory : tiene >
Paciente "1" --> "0..*" Appointment : agenda >
Paciente "1" --> "0..*" Prescription : recibe >
Paciente "1" --> "0..*" LabResult : genera >
Paciente "1" --> "0..*" Alert : recibe >
Paciente "1" --> "0..*" WearableData : sincroniza >
Paciente "1" --> "0..*" ChatConversation : inicia >
Paciente "1" --> "0..*" SymptomReport : reporta >
Paciente "1" --> "0..*" InformedConsent : firma >

Doctor "1" --> "0..*" MedicalHistory : registra >
Doctor "1" --> "0..*" Appointment : atiende >
Doctor "1" --> "0..*" Prescription : emite >
Doctor "1" --> "0..*" LabResult : revisa >
Doctor "1" --> "0..*" Referral : emite >
Doctor "1" --> "0..*" AIAnalysis : consulta >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — IA y Análisis
' ═══════════════════════════════════════════════════════════════════

SymptomReport "1" --> "0..1" AIAnalysis : origina >
SymptomReport "1" *-- "1..*" ReportedSymptom : contiene >
AIAnalysis "1" *-- "0..*" PossibleDiagnosis : produce >
AIAnalysis "1" *-- "0..*" Symptom : analiza >
MLExperiment "1" *-- "0..*" ExperimentLog : registra >
WearableData "1" --> "0..1" Alert : puede generar >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — Derivaciones y Citas
' ═══════════════════════════════════════════════════════════════════

Referral "1" --> "0..1" Appointment : puede generar >
MedicalHistory "1" --> "0..*" Referral : puede originar >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — Chat
' ═══════════════════════════════════════════════════════════════════

ChatConversation "1" *-- "1..*" ChatMessage : contiene >
ChatConversation "1" *-- "0..1" ConversationSummary : resume >
ChatConversation "1" --> "0..1" AIAnalysis : puede generar >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — Consentimiento
' ═══════════════════════════════════════════════════════════════════

InformedConsent "1" *-- "1..*" ConsentSignature : requiere >
InformedConsent "1" --> "0..*" ConsentLog : registra >
Appointment "1" --> "0..1" InformedConsent : requiere >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — Reportes
' ═══════════════════════════════════════════════════════════════════

Administrador "1" --> "0..*" AutomaticReport : genera >
AutomaticReport "1" *-- "1" DateRange : abarca >

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — Servicios Backend
' ═══════════════════════════════════════════════════════════════════

AlertService ..> Alert : <<crea / gestiona>>
AlertService ..> SMSService : <<usa>>
AIIntegrationService ..> AIAnalysis : <<produce>>
AIIntegrationService ..> SymptomReport : <<procesa>>
EmergencyService ..> Alert : <<genera>>
EmergencyService ..> GeolocationHook : <<usa>>
LabService ..> LabResult : <<importa / gestiona>>
FHIRService ..> MedicalHistory : <<exporta>>

' ═══════════════════════════════════════════════════════════════════
' RELACIONES — Capa Mobile
' ═══════════════════════════════════════════════════════════════════

NotificationService ..> Alert : <<sincroniza>>
GeolocationHook *-- GeoLocation : retorna >
NetworkStatusHook --> ConnectionType : reporta >

