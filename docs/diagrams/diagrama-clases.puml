@startuml DiagramaClases_RespiCare
' ═══════════════════════════════════════════════════════════════════
' Diagrama de Clases — Sistema RespiCare
' Enfermedades Respiratorias
' ═══════════════════════════════════════════════════════════════════

!theme plain
skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #374151
skinparam classFontColor #111827
skinparam classHeaderBackgroundColor #1E3A5F
skinparam classHeaderFontColor #FFFFFF
skinparam classHeaderFontSize 13
skinparam classFontSize 11
skinparam arrowColor #374151
skinparam arrowThickness 1.5
skinparam noteBackgroundColor #FEF3C7
skinparam noteBorderColor #D97706
skinparam packageBackgroundColor #F3F4F6
skinparam packageBorderColor #9CA3AF
skinparam linetype ortho

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: USUARIOS Y AUTENTICACIÓN
' ═══════════════════════════════════════════════════════════════════

package "Usuarios y Autenticación" #EFF6FF {

  enum RolUsuario {
    PATIENT
    DOCTOR
    ADMIN
  }

  abstract class Usuario {
    # _id : ObjectId
    # name : String
    # email : String
    # password : String {hashed}
    # role : RolUsuario
    # phone : String
    # avatar : String
    # isActive : Boolean
    # lastLogin : Date
    # createdAt : Date
    # updatedAt : Date
    --
    + comparePassword(candidate) : Boolean
    + toJSON() : Object
    {static} findByEmail(email) : Usuario
    {static} findActive() : Usuario[]
    {static} findByRole(role) : Usuario[]
  }

  class Paciente {
    + medicalHistories : MedicalHistory[]
    + appointments : Appointment[]
    + wearableDevices : WearableData[]
    + emergencyContacts : EmergencyContact[]
    --
    + getLatestVitals() : WearableData
    + getActiveAlerts() : Alert[]
  }

  class Doctor {
    + specialization : String
    + licenseNumber : String
    + department : String
    + consultationFee : Number
    --
    + getPatients() : Paciente[]
    + getPendingReferrals() : Referral[]
    + getAppointmentsToday() : Appointment[]
  }

  class Administrador {
    + canManageUsers : Boolean
    + canGenerateReports : Boolean
    + canDeleteData : Boolean
    --
    + generateSystemReport() : AutomaticReport
    + manageFeatureFlags() : void
  }

  class AuditLog {
    + _id : ObjectId
    + userId : String
    + action : String
    + resource : String
    + resourceId : String
    + method : String
    + endpoint : String
    + statusCode : Number
    + ipAddress : String
    + userAgent : String
    + requestBody : Object
    + responseTime : Number
    + timestamp : Date
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: HISTORIAL CLÍNICO
' ═══════════════════════════════════════════════════════════════════

package "Historial Clínico" #F0FDF4 {

  class MedicalHistory {
    + _id : ObjectId
    + patientId : String
    + doctorId : String
    + patientName : String
    + diagnosis : String
    + symptoms : Symptom[]
    + date : Date
    + notes : String
    + icd10Code : String
    + severity : String
    + isRespiratory : Boolean
    + vitals : Vitals
    + treatment : String
    + followUpDate : Date
    + location : GeoPoint
    + createdAt : Date
    --
    + getRespiratoryHistory() : MedicalHistory[]
    {static} findByPatient(patientId) : MedicalHistory[]
    {static} findByDoctor(doctorId) : MedicalHistory[]
  }

  class Symptom {
    + name : String
    + severity : String
    + duration : String
    + onset : String
    + location : String
    + character : String
  }

  class Vitals {
    + heartRate : Number
    + bloodPressureSystolic : Number
    + bloodPressureDiastolic : Number
    + temperature : Number
    + oxygenSaturation : Number
    + respiratoryRate : Number
  }

  class LabResult {
    + _id : ObjectId
    + patientId : String
    + testName : String
    + testCode : String
    + value : String | Number
    + unit : String
    + referenceRange : ReferenceRange
    + status : LabStatus
    + date : Date
    + reviewedBy : String
    + reviewedAt : Date
    + labName : String
    + notes : String
    + createdAt : Date
    --
    + isAbnormal() : Boolean
    + isCritical() : Boolean
    + markAsReviewed(doctorId) : void
    {static} findByPatient(patientId) : LabResult[]
    {static} findCritical(patientId) : LabResult[]
  }

  enum LabStatus {
    NORMAL
    ABNORMAL
    CRITICAL
  }

  class ReferenceRange {
    + min : Number
    + max : Number
    + unit : String
    + description : String
  }

  class Prescription {
    + _id : ObjectId
    + patientId : String
    + doctorId : String
    + medications : Medication[]
    + startDate : Date
    + endDate : Date
    + status : PrescriptionStatus
    + instructions : String
    + diagnosis : String
    + interactions : DrugInteraction[]
    + createdAt : Date
    --
    + checkInteractions() : DrugInteraction[]
    + isActive() : Boolean
  }

  class Medication {
    + name : String
    + dosage : String
    + unit : String
    + frequencyPerDay : Number
    + durationDays : Number
    + route : String
    + instructions : String[]
  }

  class DrugInteraction {
    + medicationA : String
    + medicationB : String
    + severity : String
    + description : String
  }

  enum PrescriptionStatus {
    ACTIVE
    COMPLETED
    CANCELLED
    SUSPENDED
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: CITAS Y DERIVACIONES
' ═══════════════════════════════════════════════════════════════════

package "Citas y Derivaciones" #FFF7ED {

  class Appointment {
    + _id : ObjectId
    + patientId : String
    + doctorId : String
    + patientName : String
    + doctorName : String
    + specialty : String
    + date : Date
    + duration : Number
    + status : AppointmentStatus
    + type : AppointmentType
    + mode : ConsultMode
    + reason : String
    + notes : String
    + diagnosis : String
    + location : Location
    + videoCallUrl : String
    + reminderSent : Boolean
    + followUp : Date
    + createdAt : Date
    --
    + confirm() : void
    + cancel(reason) : void
    + reschedule(newDate) : void
    {static} getAvailableSlots(doctorId, date) : Date[]
  }

  enum AppointmentStatus {
    SCHEDULED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELLED
    RESCHEDULED
    NO_SHOW
  }

  enum ConsultMode {
    IN_PERSON
    TELEMEDICINE
    HOME_VISIT
  }

  class Referral {
    + _id : ObjectId
    + patientId : String
    + patientName : String
    + referringDoctorId : String
    + referringDoctorName : String
    + referredToDoctorId : String
    + referredToDoctorName : String
    + referredToSpecialty : String
    + referralType : ReferralType
    + priority : ReferralPriority
    + status : ReferralStatus
    + reason : String
    + clinicalSummary : String
    + attachments : String[]
    + scheduledDate : Date
    + completedDate : Date
    + notes : String
    + createdAt : Date
    --
    + accept() : void
    + reject(reason) : void
    + complete() : void
  }

  enum ReferralPriority {
    LOW
    NORMAL
    HIGH
    URGENT
  }

  enum ReferralStatus {
    PENDING
    ACCEPTED
    REJECTED
    COMPLETED
    CANCELLED
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: ANÁLISIS IA Y SÍNTOMAS
' ═══════════════════════════════════════════════════════════════════

package "Análisis IA y Síntomas" #FDF4FF {

  class SymptomReport {
    + _id : ObjectId
    + patientId : String
    + symptoms : ReportedSymptom[]
    + duration : String
    + severity : String
    + additionalNotes : String
    + urgencyScore : Number
    + urgencyLevel : UrgencyLevel
    + aiAnalyzed : Boolean
    + followUpRequired : Boolean
    + status : String
    + createdAt : Date
    --
    + analyze() : AIAnalysis
    + requestFollowUp() : void
  }

  class ReportedSymptom {
    + name : String
    + severity : SeverityLevel
    + duration : String
    + onset : String
    + frequency : String
  }

  enum UrgencyLevel {
    LOW
    MEDIUM
    HIGH
    CRITICAL
  }

  enum SeverityLevel {
    MILD
    MODERATE
    SEVERE
  }

  class AIAnalysis {
    + _id : ObjectId
    + patientId : String
    + doctorId : String
    + symptoms : Symptom[]
    + possibleDiagnoses : PossibleDiagnosis[]
    + urgency : UrgencyLevel
    + urgencyScore : Number
    + confidence : Number
    + recommendations : String[]
    + modelVersion : String
    + modelName : String
    + processingTime : Number
    + status : String
    + analyzedAt : Date
    + createdAt : Date
    --
    + getTopDiagnosis() : PossibleDiagnosis
    + needsUrgentAttention() : Boolean
    {static} findByPatient(patientId) : AIAnalysis[]
    {static} findCritical() : AIAnalysis[]
  }

  class PossibleDiagnosis {
    + disease : String
    + icd10Code : String
    + probability : Number
    + confidence : Number
    + reasoning : String
  }

  class MLExperiment {
    + _id : ObjectId
    + name : String
    + type : ExperimentType
    + status : ExperimentStatus
    + modelId : String
    + config : Object
    + metrics : Object
    + results : Object
    + logs : ExperimentLog[]
    + startedAt : Date
    + completedAt : Date
    + createdAt : Date
    --
    + start() : void
    + stop() : void
    + getMetrics() : Object
  }

  enum ExperimentType {
    RL_SESSION
    FL_ROUND
    AUTOML_PIPELINE
    PREDICTION
    TRAINING
    EVALUATION
  }

  enum ExperimentStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
    CANCELLED
  }

  class ExperimentLog {
    + timestamp : Date
    + level : LogLevel
    + message : String
    + data : Object
  }

  enum LogLevel {
    INFO
    WARNING
    ERROR
    DEBUG
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: ALERTAS Y NOTIFICACIONES
' ═══════════════════════════════════════════════════════════════════

package "Alertas y Notificaciones" #FFF1F2 {

  class Alert {
    + _id : ObjectId
    + patientId : String
    + doctorId : String
    + title : String
    + message : String
    + level : AlertLevel
    + type : AlertType
    + status : AlertStatus
    + channels : NotificationChannel[]
    + referenceId : String
    + referenceModel : String
    + metadata : Object
    + trigger : AlertTrigger
    + acknowledgedAt : Date
    + resolvedAt : Date
    + expiresAt : Date
    + retryCount : Number
    + createdAt : Date
    --
    + acknowledge(userId) : void
    + resolve(userId) : void
    + retry() : void
    + isExpired() : Boolean
  }

  enum AlertLevel {
    INFO
    WARNING
    HIGH
    CRITICAL
  }

  enum AlertStatus {
    PENDING
    SENT
    ACKNOWLEDGED
    RESOLVED
    EXPIRED
    FAILED
  }

  enum NotificationChannel {
    EMAIL
    SMS
    PUSH
    IN_APP
    WHATSAPP
  }

  class AlertTrigger {
    + type : String
    + threshold : Number
    + condition : String
    + metric : String
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: WEARABLES Y MONITOREO
' ═══════════════════════════════════════════════════════════════════

package "Wearables y Monitoreo" #F0FDFA {

  class WearableData {
    + _id : ObjectId
    + patientId : ObjectId
    + deviceId : String
    + deviceType : String
    + heartRate : Number
    + oxygenSaturation : Number
    + steps : Number
    + calories : Number
    + sleepHours : Number
    + respiratoryRate : Number
    + skinTemperature : Number
    + timestamp : Date
    + syncedAt : Date
    + createdAt : Date
    --
    + isAbnormal() : Boolean
    + triggerAlertIfNeeded() : Alert
    {static} getLatestByPatient(patientId) : WearableData
    {static} getAverages(patientId, days) : Object
  }

}

' ═══════════════════════════════════════════════════════════════════
' PAQUETE: CHAT Y CONVERSACIONES IA
' ═══════════════════════════════════════════════════════════════════

package "Chat e IA Conversacional" #F5F3FF {

  class ChatConversation {
    + _id : ObjectId
    + patientId : String
    + sessionId : String
    + title : String
    + messages : ChatMessage[]
    + status : ConversationStatus
    + summary : ConversationSummary
    + isArchived : Boolean
    + startedAt : Date
    + endedAt : Date
    + createdAt : Date
    --
    + addMessage(role, content) : void
    + getMessageCount() : Number
    + generateSummary() : ConversationSummary
    + close() : void
  }

  class ChatMessage {
    + role : MessageRole
    + content : String
    + timestamp : Date
    + metadata : Object
  }

  class ConversationSummary {
    + urgencyScore : Number
    + symptomCount : Number
    + mentionedDiseases : Number
    + highestUrgency : UrgencyLevel
    + keySymptoms : String[]
    + recommendation : String
  }

  enum MessageRole {
    USER
    ASSISTANT
    SYSTEM
  }

  enum ConversationStatus {
    ACTIVE
    CLOSED
    ARCHIVED
  }

}

