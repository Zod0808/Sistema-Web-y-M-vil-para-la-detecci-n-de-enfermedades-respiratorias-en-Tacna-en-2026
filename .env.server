# MongoDB Atlas — copia la connection string de tu Atlas
  MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/respicare?retryWrites=true&w=majority

  # Redis
  REDIS_PASSWORD=pon_una_password_segura_aqui

  # JWT — genera con: openssl rand -base64 64
  JWT_SECRET=genera_un_secreto_largo_aqui
  JWT_REFRESH_SECRET=genera_otro_secreto_largo_aqui

  # CORS — dominios permitidos (separados por coma)
  # Pon la IP de tu VM y tu dominio si tienes uno
  CORS_ORIGIN=http://TU_IP_VM,https://TU_DOMINIO.com

  # OpenAI (si el AI service lo usa)
  OPENAI_API_KEY=sk-...

  # Email (si usas notificaciones)
  SMTP_HOST=smtp.gmail.com
  SMTP_PORT=587
  SMTP_USER=tu@gmail.com
  SMTP_PASS=tu_app_password
