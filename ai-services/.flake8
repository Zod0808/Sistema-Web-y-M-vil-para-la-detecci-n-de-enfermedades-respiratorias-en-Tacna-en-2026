[flake8]
max-line-length = 100
exclude = 
    venv,
    __pycache__,
    migrations,
    models,
    node_modules,
    .git,
    .eggs,
    *.egg
ignore = 
    E203,  # whitespace before ':'
    E266,  # too many leading '#' for block comment
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    F401   # imported but unused (handled by pylint)
max-complexity = 10
per-file-ignores =
    __init__.py:F401

