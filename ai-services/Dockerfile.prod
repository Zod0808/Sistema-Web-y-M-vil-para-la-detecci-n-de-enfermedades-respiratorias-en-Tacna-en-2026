# Multi-stage build for production
FROM python:3.14-slim@sha256:b877e50bd90de10af8d82c57a022fc2e0dc731c5320d762a27986facfc3355c1 AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install system-wide (not --user) so non-root user can access the binaries
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    grep -v "^openai-whisper\|^ffmpeg-python" requirements.txt \
    | pip install --no-cache-dir -r /dev/stdin

# Download spaCy model (non-critical, falls back to runtime download)
RUN python -m spacy download en_core_web_sm 2>/dev/null || \
    (curl -L -f https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.6.1/en_core_web_sm-3.6.1-py3-none-any.whl -o /tmp/en_core_web_sm.whl 2>/dev/null && \
     pip install --no-cache-dir /tmp/en_core_web_sm.whl && \
     rm -f /tmp/en_core_web_sm.whl) || \
    echo "Note: spaCy model will be downloaded at runtime if needed"

# Production stage
FROM python:3.14-slim@sha256:b877e50bd90de10af8d82c57a022fc2e0dc731c5320d762a27986facfc3355c1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder (system-wide paths)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY . .

RUN mkdir -p /app/models /app/cache /app/logs /app/data/samples

RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app

USER app

ENV PYTHONPATH=/app \
    MODEL_PATH=/app/models \
    CACHE_PATH=/app/cache \
    LOG_LEVEL=INFO \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=30s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--timeout-keep-alive", "120", "--limit-concurrency", "500", "--backlog", "1024"]
