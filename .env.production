# =============================================================
# RespiCare — PRODUCCIÓN
# Copiar a .env en el servidor y rellenar todos los valores
# NUNCA subir este archivo con valores reales al repositorio
# =============================================================

# ======================
# APPLICATION
# ======================
NODE_ENV=production
APP_NAME=RespiCare
APP_URL=https://TU_DOMINIO_AQUI
PORT=3001
HOST=0.0.0.0

# ======================
# DATABASE
# ======================
MONGO_USERNAME=respicare_admin
MONGO_PASSWORD=CAMBIAR_PASSWORD_FUERTE_AQUI
MONGO_DB=respicare
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGODB_URI=mongodb://respicare_admin:CAMBIAR_PASSWORD_FUERTE_AQUI@mongodb:27017/respicare?authSource=admin

# ======================
# REDIS
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD_AQUI
REDIS_URL=redis://:CAMBIAR_REDIS_PASSWORD_AQUI@redis:6379

# ======================
# SEGURIDAD — generar con: openssl rand -base64 64
# ======================
JWT_SECRET=GENERAR_CON_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=GENERAR_CON_OPENSSL_RAND_BASE64_64_DIFERENTE
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
BCRYPT_ROUNDS=12

# ======================
# CORS — URLs que pueden acceder al API
# ======================
CORS_ORIGINS=https://TU_DOMINIO_AQUI

# ======================
# FRONTEND (build-time — necesarios antes de npm run build)
# ======================
REACT_APP_BACKEND_URL=https://TU_DOMINIO_AQUI
REACT_APP_WS_URL=wss://TU_DOMINIO_AQUI
REACT_APP_AI_URL=https://TU_DOMINIO_AQUI/ai
REACT_APP_ENV=production

# ======================
# AI SERVICES
# ======================
AI_SERVICE_URL=http://ai-services:8000
OPENAI_API_KEY=sk-CLAVE_REAL_DE_OPENAI_AQUI
AI_MODEL=gpt-4
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ======================
# EMAIL (usar App Password de Gmail o SMTP propio)
# ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=TU_EMAIL@gmail.com
SMTP_PASS=APP_PASSWORD_DE_16_CHARS
EMAIL_FROM=noreply@TU_DOMINIO_AQUI
FROM_EMAIL=noreply@TU_DOMINIO_AQUI

# ======================
# PUSH NOTIFICATIONS
# ======================
PUSH_PROVIDER=expo
PUSH_API_KEY=TU_EXPO_API_KEY
PUSH_PROJECT_ID=TU_EXPO_PROJECT_ID

# ======================
# TOKENS INTERNOS
# ======================
INTERNAL_SERVICE_TOKENS=GENERAR_TOKEN_1,GENERAR_TOKEN_2
CRITICAL_ALERT_ROLES=doctor,admin

# ======================
# ALERTAS / JOBS
# ======================
ALERTS_SCHEDULED_INTERVAL_MS=30000
ALERTS_PENDING_INTERVAL_MS=45000

# ======================
# LOGGING
# ======================
LOG_LEVEL=info
LOG_FORMAT=json

# ======================
# MONITOREO
# ======================
ENABLE_METRICS=true
METRICS_PORT=9090

# ======================
# BACKUP
# ======================
BACKUP_RETENTION_DAYS=30

# ======================
# AI RATE LIMITING
# ======================
AI_RATE_LIMIT_ENABLED=1
AI_RATE_LIMIT_CAPACITY=500
AI_RATE_LIMIT_REFILL_PER_SEC=20.0
AI_MAX_BODY_BYTES=4194304
