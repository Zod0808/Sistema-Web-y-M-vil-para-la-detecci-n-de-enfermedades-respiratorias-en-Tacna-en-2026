# Emulador Android (AVD en Windows/Mac)
# 10.0.2.2 apunta al host del emulador, NO a la VM
# Usar la IP LAN de la VM a través de nginx (puerto 80)
# nginx enruta: /api/ → backend:3001  |  /ai/ → ai-services:8000

NEXT_PUBLIC_API_URL=http://192.168.18.29/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://192.168.18.29/ai/api/v1
