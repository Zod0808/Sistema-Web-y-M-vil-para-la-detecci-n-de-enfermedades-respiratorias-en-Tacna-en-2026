# RespiCare Tacna - Mobile App Environment Variables
# Copy this file and rename it to .env.local (dev), .env.staging, or .env.production
# Never commit .env.local with real values to version control.

# Backend API base URL (include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# AI/ML service base URL (FastAPI)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000