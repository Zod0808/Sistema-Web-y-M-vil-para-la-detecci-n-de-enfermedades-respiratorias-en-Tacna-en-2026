# RespiCare Mobile - Environment Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# API Configuration
# ===========================================
# Backend API URL (development)
API_BASE_URL=http://localhost:3001/api/v1

# AI Services URL (development)
AI_SERVICE_URL=http://localhost:8000/api/v1

# WebSocket URL (development)
WS_URL=ws://localhost:3001

# ===========================================
# Authentication
# ===========================================
# JWT Secret (should match backend)
JWT_SECRET=your_super_secret_jwt_key_here

# Token expiration (in seconds)
JWT_EXPIRE=604800

# Refresh token expiration (in seconds)
JWT_REFRESH_EXPIRE=2592000

# ===========================================
# AI Services
# ===========================================
# OpenAI API Key (for AI analysis)
OPENAI_API_KEY=your_openai_api_key_here

# AI Service timeout (in milliseconds)
AI_SERVICE_TIMEOUT=30000

# Enable AI debug logs
AI_DEBUG_LOGS=true

# ===========================================
# Database & Storage
# ===========================================
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/respicare

# Redis connection string
REDIS_URL=redis://localhost:6379

# Local storage max size (in bytes)
MAX_STORAGE_SIZE=52428800

# Cache expiration time (in seconds)
CACHE_EXPIRATION=86400

# ===========================================
# Sync Configuration
# ===========================================
# Sync interval (in milliseconds)
SYNC_INTERVAL=300000

# Max retry attempts
MAX_RETRY_ATTEMPTS=3

# Batch size for sync operations
SYNC_BATCH_SIZE=10

# ===========================================
# Notifications
# ===========================================
# Enable push notifications
ENABLE_PUSH_NOTIFICATIONS=true

# Enable local notifications
ENABLE_LOCAL_NOTIFICATIONS=true

# Max notifications to store
MAX_NOTIFICATIONS=50

# Emergency notification timeout (in milliseconds)
EMERGENCY_TIMEOUT=5000

# ===========================================
# Security
# ===========================================
# Enable encryption for local data
ENABLE_ENCRYPTION=true

# Encryption key (should be different for each environment)
ENCRYPTION_KEY=your_encryption_key_here

# Enable certificate pinning
ENABLE_CERTIFICATE_PINNING=false

# ===========================================
# Debug & Development
# ===========================================
# Enable debug mode
DEBUG_MODE=true

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# Enable error reporting
ENABLE_ERROR_REPORTING=true

# Enable analytics
ENABLE_ANALYTICS=false

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# ===========================================
# Feature Flags
# ===========================================
# Enable offline mode
ENABLE_OFFLINE_MODE=true

# Enable AI analysis
ENABLE_AI_ANALYSIS=true

# Enable chatbot
ENABLE_CHATBOT=true

# Enable location tracking
ENABLE_LOCATION_TRACKING=true

# Enable file upload
ENABLE_FILE_UPLOAD=true

# Enable voice recording
ENABLE_VOICE_RECORDING=true

# Enable emergency mode
ENABLE_EMERGENCY_MODE=true

# ===========================================
# Production Overrides
# ===========================================
# Uncomment and update for production deployment

# API_BASE_URL=https://api.respicare.com/v1
# AI_SERVICE_URL=https://ai.respicare.com/api/v1
# WS_URL=wss://api.respicare.com
# DEBUG_MODE=false
# ENABLE_ANALYTICS=true
# LOG_LEVEL=info
# ENABLE_CERTIFICATE_PINNING=true
