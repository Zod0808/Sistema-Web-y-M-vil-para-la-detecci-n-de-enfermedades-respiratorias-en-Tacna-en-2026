{
  "name": "respicare-web",
  "version": "1.0.0",
  "description": "RespiCare Frontend Application",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --testPathPattern=__tests__ --coverage",
    "test:watch": "react-scripts test --watch",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@types/xml2js": "^0.4.14",
    "axios": "^1.12.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "react-scripts": "^5.0.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "recharts": "^3.3.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "cypress": "^13.6.0",
    "isomorphic-dompurify": "^2.9.0",
    "jest": "^25.0.0",
    "jest-axe": "^8.0.0",
    "jest-junit": "^16.0.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:3001",
  "overrides": {
    "braces": ">=3.0.3",
    "form-data": ">=2.5.4",
    "node-notifier": ">=8.0.1",
    "tough-cookie": ">=4.1.3",
    "nth-check": ">=2.0.1",
    "postcss": ">=8.4.31",
    "micromatch": ">=4.0.8",
    "typescript": "^4.9.5",
    "yaml": "2.8.1"
  }
}
